    {
        "z": "vm_zp_tab",
        "id": "vm_zp_fn_restore",
        "type": "function",
        "name": "restore schedule",
        "func": "// Reads the saved schedule from the file and sends it to the heating.\n// Output 1: setSchedule command\n// Output 2: reset for the return timer\n\nlet entries;\ntry {\n    entries = JSON.parse(String(msg.payload || '').trim());\n    if (typeof entries === 'string') entries = JSON.parse(entries);\n} catch (e) {\n    node.status({ fill: 'red', shape: 'ring', text: 'file empty or invalid' });\n    node.error('Saved schedule not readable: ' + e.message, msg);\n    return null;\n}\nif (entries && entries.newSchedule) entries = entries.newSchedule;\n\nflow.set('vmCircTempActive', false);\nnode.status({ fill: 'green', shape: 'dot', text: new Date().toLocaleTimeString() + ': schedule restored' });\nreturn [{ topic: 'dhwCircSchedRestore', payload: { newSchedule: entries } }, { reset: true }];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "outputLabels": [
            "setSchedule",
            "timer reset"
        ],
        "x": 670,
        "y": 390,
        "wires": [
            [
                "vm_zp_write"
            ],
            [
                "vm_zp_trigger"
            ]
        ]
    },
