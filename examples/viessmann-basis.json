    {
        "id": "vm_c_3",
        "type": "comment",
        "z": "vm_tab_1",
        "name": "3) Schreiben – steht auf TESTLAUF, sendet nichts an die Anlage",
        "info": "Zum Scharfschalten: in der Konfiguration \"Schreibzugriff erlauben\" setzen und in der Schreib-Node den Haken \"Testlauf\" entfernen.",
        "x": 320,
        "y": 420,
        "wires": []
    },
    {
        "id": "vm_inject_dhw",
        "type": "inject",
        "z": "vm_tab_1",
        "name": "Warmwasser 55 °C",
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "feature",
                "v": "heating.dhw.temperature.main",
                "vt": "str"
            },
            {
                "p": "command",
                "v": "setTargetTemperature",
                "vt": "str"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "{\"temperature\":55}",
        "payloadType": "json",
        "x": 170,
        "y": 480,
        "wires": [
            [
                "vm_write"
            ]
        ]
    },
    {
        "id": "vm_inject_mode",
