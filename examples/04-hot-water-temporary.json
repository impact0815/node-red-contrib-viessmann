    {
        "z": "vm_ww_tab",
        "id": "vm_ww_read",
        "type": "viessmann-read",
        "name": "read hot water schedule",
        "server": "",
        "selection": "selected",
        "features": [
            "heating.dhw.schedule"
        ],
        "pattern": "",
        "outputFormat": "object",
        "onlyAvailable": true,
        "topicPrefix": "viessmann",
        "interval": 0,
        "startupDelay": 10,
        "staleAfter": 900,
        "forceRefresh": true,
        "x": 440,
        "y": 180,
        "wires": [
