                "vm_ww_fn_eval"
            ],
            [
                "vm_ww_dbg_err"
            ]
        ]
    },
    {
        "z": "vm_ww_tab",
        "id": "vm_ww_fn_eval",
        "type": "function",
        "name": "save / ON schedule",
        "func": "// Evaluates the schedule that was read.\n// Output 1: schedule to save in the file\n// Output 2: temporary ON schedule (only if msg.action === \"on\")\n//\n// Protection: while the temporary ON schedule is active, nothing is saved –\n// otherwise the ON schedule would overwrite the real schedule in the file.\n// Schutz: Läuft der temporäre AN-Plan, wird NICHT gesichert.\n\nconst f = msg.payload && msg.payload['heating.dhw.schedule'];\nconst entries = f && f.values ? f.values.entries : null;\n\nif (!entries || typeof entries !== 'object') {\n    node.status({ fill: 'red', shape: 'ring', text: 'no schedule read' });\n    node.warn('Data point heating.dhw.schedule not found or empty.');\n    return null;\n}\n\nconst tempActive = flow.get('vmDhwTempActive') === true;\nlet save = null;\nif (!tempActive) {\n    save = { topic: 'dhwSched', payload: JSON.stringify(entries) };\n} else {\n    node.warn('Temporary ON schedule active – current schedule is not saved.');\n}\n\nlet on = null;\nif (msg.action === 'on') {\n    // Hot water ON during the day – adjust if needed (max. 4 entries per day, 10 min grid)\n    const day = [{ start: '06:00', end: '21:00', mode: 'on', position: 0 }];\n    on = { topic: 'dhwSchedOn', payload: { newSchedule: {\n        mon: day, tue: day, wed: day, thu: day, fri: day, sat: day, sun: day\n    } } };\n    flow.set('vmDhwTempActive', true);\n}\n\nnode.status({ fill: 'green', shape: 'dot',\n    text: new Date().toLocaleTimeString() + ': ' + (save ? 'saved' : 'not saved') + (on ? ', ON schedule sent' : '') });\nreturn [save, on];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "outputLabels": [
            "save schedule",
            "ON schedule"
        ],
        "x": 670,
        "y": 180,
        "wires": [
            [
                "vm_ww_file_out"
            ],
            [
                "vm_ww_write",
                "vm_ww_trigger"
            ]
        ]
    },
